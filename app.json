{
  "expo": {
    "name": "Q-Pino",
    "slug": "QVAC",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "qvac",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "io.qvac.installedbase",
      "appleTeamId": "33M83H9SVB",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Se usa el micrófono para dictar observaciones de equipos durante la visita.",
        "NSCameraUsageDescription": "Se usa la cámara para fotografiar placas y etiquetas de los equipos."
      }
    },
    "android": {
      "package": "io.qvac.installedbase",
      "adaptiveIcon": {
        "backgroundColor": "#F3EFE6",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "RECORD_AUDIO",
        "CAMERA"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F3EFE6",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 72
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 29
          }
        }
      ],
      "@qvac/sdk/expo-plugin",
      "@siteed/audio-studio",
      "expo-image-picker",
      "expo-asset",
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
